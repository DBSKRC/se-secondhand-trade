@startuml
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #82515F
skinparam LineColor #CBB7BA
skinparam BorderColor #CBB7BA
skinparam FontColor #382A30
skinparam classBackgroundColor #FFFCF8
skinparam classHeaderBackgroundColor #EFDFE2
skinparam classBorderColor #B9939D
skinparam classFontColor #382A30
skinparam packageBackgroundColor #F8F2EC
skinparam packageBorderColor #D6C3BA
skinparam componentBackgroundColor #FFFDFC
skinparam componentBorderColor #B9939D
skinparam stateBackgroundColor #FCF7F2
skinparam stateBorderColor #B9939D
skinparam sequenceLifeLineBorderColor #CBB7BA
skinparam sequenceParticipantBackgroundColor #EFDFE2
skinparam sequenceParticipantBorderColor #9B6574
skinparam sequenceGroupBackgroundColor #FBF7F3
skinparam sequenceGroupBorderColor #C6A6AF
skinparam sequenceDividerBackgroundColor #EFDFE2
skinparam noteBackgroundColor #F7EDDC
skinparam noteBorderColor #CDBB9E

skinparam classAttributeIconSize 0
skinparam nodesep 120
skinparam ranksep 64
skinparam linetype ortho
hide circle
class "账号 User" as U {
 - id: UUID
 - account: String
 - role: Role
 + canManage(item): Boolean
}
class "商品 Item" as I {
 - id: UUID
 - price: Decimal
 - status: ItemState
 - version: Long
 + submitReview(): void
 + revise(fields): void
 + withdraw(): void
}
class "预约 Reservation" as R {
 - id: UUID
 - buyer: User
 - priceSnapshot: Decimal
 - status: ReservationState
 + accept(): void
 + cancel(): void
 + complete(): void
}
class "举报 Report" as P {
 - reporter: User
 - reason: String
 - result: String
 + handle(result): void
}
class "审核 Review" as V {
 - decision: String
 - reason: String
 + decide(result): void
}
class "争议 Dispute" as D {
 - reason: String
 + appendOpinion(text): void
}
U "1" -right- "0..*" I
I "1" -right- "0..*" R
I "1" -down- "0..*" V
I "1" -down- "0..*" P
R "1" -down- "0..*" D
U -[hidden]down- P
P -[hidden]right- V
V -[hidden]right- D
@enduml
